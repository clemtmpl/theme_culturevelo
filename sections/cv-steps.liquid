{%- comment -%}
  RC Bike — étapes numérotées (« Comment ça se passe »).
  Chaque bloc « Étape » : titre + texte. Les numéros se comptent tout seuls.
  Sur ordinateur, les étapes sont alignées et reliées par un trait ; sur mobile, elles s'empilent.
{%- endcomment -%}

<section class="cv-steps cv-wrap" id="cv-steps-{{ section.id }}">
  {%- if section.settings.heading != blank -%}
    <header class="cv-steps__head">
      {%- if section.settings.eyebrow != blank -%}
        <p class="cv-steps__eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      <h2 class="cv-steps__title">{{ section.settings.heading | escape }}</h2>
    </header>
  {%- endif -%}

  <ol class="cv-steps__list" style="--cv-steps-count: {{ section.blocks.size | at_least: 1 }};">
    {%- for block in section.blocks -%}
      <li class="cv-steps__item" {{ block.shopify_attributes }}>
        <span class="cv-steps__num" aria-hidden="true">{{ forloop.index }}</span>
        <h3 class="cv-steps__name">{{ block.settings.title | escape }}</h3>
        {%- if block.settings.text != blank -%}
          <p class="cv-steps__text">{{ block.settings.text | escape }}</p>
        {%- endif -%}
      </li>
    {%- else -%}
      <li class="cv-steps__empty">Ajoutez des blocs « Étape ».</li>
    {%- endfor -%}
  </ol>
</section>

{% stylesheet %}
  .cv-steps { padding-block: clamp(2rem, 5vw, 4rem); }

  .cv-steps__head { margin-block-end: 2rem; }

  .cv-steps__eyebrow {
    margin: 0 0 0.5rem;
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--cv-blue, #0969a8);
  }

  .cv-steps__title {
    margin: 0;
    font-family: var(--font-heading--family);
    font-size: clamp(1.75rem, 3.6vw, 2.5rem);
    line-height: 1;
    font-weight: 800;
    font-stretch: 115%;
    letter-spacing: -0.015em;
    text-transform: uppercase;
    color: var(--cv-navy, #032942);
  }

  .cv-steps__list {
    display: grid;
    gap: 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
    grid-template-columns: 1fr;
  }

  @media (min-width: 750px) {
    .cv-steps__list { grid-template-columns: repeat(min(var(--cv-steps-count, 3), 4), minmax(0, 1fr)); gap: 1.25rem; }
  }

  .cv-steps__item {
    position: relative;
    padding: 1.5rem;
    background: #fff;
    border: 1px solid var(--cv-line, #d5dee6);
    border-radius: var(--cv-radius, 18px);
  }

  .cv-steps__num {
    display: grid;
    place-items: center;
    inline-size: 44px;
    block-size: 44px;
    margin-block-end: 1rem;
    border-radius: 50%;
    font-family: var(--font-heading--family);
    font-size: 1.25rem;
    font-weight: 800;
    color: #fff;
    background: linear-gradient(150deg, var(--cv-blue-hover, #00a5e2), var(--cv-blue, #0969a8));
    box-shadow: 0 10px 24px -10px rgb(9 105 168 / 70%);
  }

  .cv-steps__name {
    margin: 0 0 0.5rem;
    font-size: 1.125rem;
    color: var(--cv-navy, #032942);
  }

  .cv-steps__text { margin: 0; color: rgb(3 41 66 / 78%); }

  @media (min-width: 750px) {
    .cv-steps__item:not(:last-child)::after {
      content: '';
      position: absolute;
      inset-block-start: calc(1.5rem + 22px);
      inset-inline-start: calc(1.5rem + 44px + 0.75rem);
      inset-inline-end: -1.25rem;
      block-size: 2px;
      border-radius: 1px;
      background: repeating-linear-gradient(90deg, var(--cv-sky, #90c4e6) 0 8px, transparent 8px 14px);
    }
  }

  .cv-steps__empty { padding: 2rem; text-align: center; color: rgb(3 41 66 / 60%); }
{% endstylesheet %}

{% schema %}
{
  "name": "CV · Étapes",
  "tag": "section",
  "class": "cv-section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Sur-titre", "default": "Simple et rapide" },
    { "type": "text", "id": "heading", "label": "Titre", "default": "Comment ça se passe" }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Étape",
      "settings": [
        { "type": "text", "id": "title", "label": "Titre", "default": "Première étape" },
        { "type": "textarea", "id": "text", "label": "Texte" }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "CV · Étapes",
      "blocks": [
        { "type": "step", "settings": { "title": "Étape 1" } },
        { "type": "step", "settings": { "title": "Étape 2" } },
        { "type": "step", "settings": { "title": "Étape 3" } }
      ]
    }
  ]
}
{% endschema %}
