{%- comment -%}
  RC Bike — navigation par type de vélo, sous la bannière d'une collection.
  Mode « collections » : une pastille par bloc (chaque bloc pointe vers une collection : Route & Gravel, VTT…).
  La barre ne s'affiche que sur les collections qui en font partie (« Tous » ou l'un des blocs).
  Mode « filtre » (si aucun bloc) : pastilles du filtre « Type de produit » de Search & Discovery.
{%- endcomment -%}

{%- liquid
  assign all_col = section.settings.all_collection
  assign blocks_mode = false
  assign show_blocks = false
  if section.blocks.size > 0
    assign blocks_mode = true
    if all_col != blank and all_col.handle == collection.handle
      assign show_blocks = true
    endif
    for block in section.blocks
      if block.settings.collection != blank and block.settings.collection.handle == collection.handle
        assign show_blocks = true
      endif
    endfor
  endif

  assign type_filter = null
  assign any_active = false
  assign shown = 0
  unless blocks_mode
    for f in collection.filters
      if f.param_name == 'filter.p.product_type'
        assign type_filter = f
      endif
    endfor
    if type_filter
      for v in type_filter.values
        if v.active
          assign any_active = true
        endif
        if v.count > 0 or v.active
          assign shown = shown | plus: 1
        endif
      endfor
    endif
  endunless
-%}

{%- if blocks_mode and show_blocks -%}
  <nav class="cv-typenav cv-wrap" aria-label="{{ section.settings.heading | escape }}">
    {%- if section.settings.heading != blank -%}
      <p class="cv-typenav__label">{{ section.settings.heading | escape }}</p>
    {%- endif -%}
    <ul class="cv-typenav__list">
      {%- if all_col != blank -%}
        {%- assign is_all = false -%}
        {%- if all_col.handle == collection.handle -%}{%- assign is_all = true -%}{%- endif -%}
        <li>
          <a class="cv-typenav__pill{% if is_all %} is-active{% endif %}" href="{{ all_col.url }}" {% if is_all %}aria-current="page"{% endif %}>
            {{- section.settings.all_label | escape -}}
            <span class="cv-typenav__count">{{ all_col.all_products_count }}</span>
          </a>
        </li>
      {%- endif -%}
      {%- for block in section.blocks -%}
        {%- assign col = block.settings.collection -%}
        {%- if col != blank -%}
          {%- assign is_cur = false -%}
          {%- if col.handle == collection.handle -%}{%- assign is_cur = true -%}{%- endif -%}
          <li {{ block.shopify_attributes }}>
            <a class="cv-typenav__pill{% if is_cur %} is-active{% endif %}" href="{{ col.url }}" {% if is_cur %}aria-current="page"{% endif %}>
              {{- block.settings.label | default: col.title | escape -}}
              <span class="cv-typenav__count">{{ col.all_products_count }}</span>
            </a>
          </li>
        {%- endif -%}
      {%- endfor -%}
    </ul>
  </nav>
{%- elsif type_filter and shown > 1 -%}
  <nav class="cv-typenav cv-wrap" aria-label="{{ section.settings.heading | escape }}">
    {%- if section.settings.heading != blank -%}
      <p class="cv-typenav__label">{{ section.settings.heading | escape }}</p>
    {%- endif -%}
    <ul class="cv-typenav__list">
      <li>
        <a
          class="cv-typenav__pill{% unless any_active %} is-active{% endunless %}"
          href="{{ collection.url }}"
          {% unless any_active %}aria-current="page"{% endunless %}
        >
          {{- section.settings.all_label | escape -}}
          <span class="cv-typenav__count">{{ collection.all_products_count }}</span>
        </a>
      </li>
      {%- for v in type_filter.values -%}
        {%- if v.count > 0 or v.active -%}
          <li>
            <a
              class="cv-typenav__pill{% if v.active %} is-active{% endif %}"
              href="{{ collection.url }}?{{ v.param_name }}={{ v.value | url_encode }}"
              {% if v.active %}aria-current="page"{% endif %}
            >
              {{- v.label | escape -}}
              <span class="cv-typenav__count">{{ v.count }}</span>
            </a>
          </li>
        {%- endif -%}
      {%- endfor -%}
    </ul>
  </nav>
{%- endif -%}

{% stylesheet %}
  .cv-typenav {
    padding-block: 1.25rem 0.25rem;
  }

  .cv-typenav__label {
    margin: 0 0 0.625rem;
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--cv-blue, #0969a8);
  }

  .cv-typenav__list {
    display: flex;
    gap: 0.5rem;
    margin: 0;
    padding: 0 0 0.25rem;
    list-style: none;
    overflow-x: auto;
    scroll-snap-type: x proximity;
    scrollbar-width: none;
  }

  .cv-typenav__list::-webkit-scrollbar { display: none; }

  @media (min-width: 750px) {
    .cv-typenav__list { flex-wrap: wrap; overflow: visible; }
  }

  .cv-typenav__list > li { flex: none; scroll-snap-align: start; }

  .cv-typenav__pill {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-block-size: 44px;
    padding-inline: 1.125rem;
    border: 1.5px solid var(--cv-line, #d5dee6);
    border-radius: 999px;
    font-weight: 700;
    font-size: 0.9375rem;
    white-space: nowrap;
    color: var(--cv-navy, #032942);
    text-decoration: none;
    background: #fff;
    transition: background-color 0.2s var(--cv-ease, ease), color 0.2s var(--cv-ease, ease),
      border-color 0.2s var(--cv-ease, ease), transform 0.2s var(--cv-ease, ease);
  }

  .cv-typenav__count {
    display: inline-grid;
    place-items: center;
    min-inline-size: 1.5rem;
    padding-inline: 0.375rem;
    block-size: 1.5rem;
    border-radius: 999px;
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--cv-blue, #0969a8);
    background: var(--cv-mist, #ebf0f5);
  }

  .cv-typenav__pill.is-active {
    color: #fff;
    border-color: var(--cv-navy, #032942);
    background: var(--cv-navy, #032942);
  }

  .cv-typenav__pill.is-active .cv-typenav__count {
    color: var(--cv-navy, #032942);
    background: #fff;
  }

  .cv-typenav__pill:focus-visible {
    outline: 3px solid var(--cv-blue-hover, #00a5e2);
    outline-offset: 2px;
  }

  @media (hover: hover) {
    .cv-typenav__pill:not(.is-active):hover {
      transform: translateY(-2px);
      border-color: var(--cv-blue, #0969a8);
      color: var(--cv-blue, #0969a8);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "CV · Navigation par type",
  "tag": "section",
  "class": "cv-section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Titre", "default": "Parcourir par type" },
    { "type": "text", "id": "all_label", "label": "Libellé « tous »", "default": "Tous" },
    {
      "type": "collection",
      "id": "all_collection",
      "label": "Collection « Tous »",
      "info": "Par exemple « Vélos »."
    }
  ],
  "blocks": [
    {
      "type": "type",
      "name": "Type",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "text", "id": "label", "label": "Libellé", "info": "Vide : le titre de la collection." }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [{ "name": "CV · Navigation par type" }]
}
{% endschema %}
