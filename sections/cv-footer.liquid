{%- comment -%}
  Culture Vélo — pied de page complet : bloc « Restez dans la roue »
  (inscription newsletter), logo + description, trois colonnes de menu
  visibles, ligne de bas de page. Remplace le pied de page d'origine.
  Les colonnes lisent des menus créés dans Contenu → Menus.
{%- endcomment -%}

<footer class="cv-foot" id="cv-foot-{{ section.id }}">
  <span class="cv-halo cv-halo--blue cv-foot__halo" aria-hidden="true"></span>

  <div class="cv-foot__inner cv-wrap">
    {%- if section.settings.nl_heading != blank -%}
      <div class="cv-foot__news cv-glass cv-glass--dark">
        <div>
          <h2 class="cv-foot__news-title">{{ section.settings.nl_heading | escape }}</h2>
          {%- if section.settings.nl_text != blank -%}
            <p class="cv-foot__news-text">{{ section.settings.nl_text | escape }}</p>
          {%- endif -%}
        </div>

        {%- form 'customer', class: 'cv-foot__form', id: 'cv-newsletter' -%}
          <input type="hidden" name="contact[tags]" value="newsletter">
          <label class="visually-hidden" for="cv-nl-email-{{ section.id }}">Adresse e-mail</label>
          <input
            id="cv-nl-email-{{ section.id }}"
            class="cv-foot__input"
            type="email"
            name="contact[email]"
            autocomplete="email"
            autocapitalize="off"
            required
            placeholder="{{ section.settings.nl_placeholder | escape }}"
            value="{{ form.email | escape }}"
          >
          <button class="cv-foot__submit" type="submit">{{ section.settings.nl_button | escape }}</button>

          {%- if form.posted_successfully? -%}
            <p class="cv-foot__msg cv-foot__msg--ok" role="status">Merci, vous êtes bien inscrit(e).</p>
          {%- endif -%}
          {%- if form.errors -%}
            <p class="cv-foot__msg cv-foot__msg--err" role="alert">{{ form.errors | default_errors }}</p>
          {%- endif -%}
        {%- endform -%}
      </div>
    {%- endif -%}

    <div class="cv-foot__grid">
      <div class="cv-foot__brand">
        <p class="cv-foot__logo">
          <strong>{{ section.settings.logo_text | default: shop.name | escape }}</strong>
          {%- if section.settings.logo_sub != blank -%}<span>{{ section.settings.logo_sub | escape }}</span>{%- endif -%}
        </p>
        {%- if section.settings.about != blank -%}
          <p class="cv-foot__about">{{ section.settings.about | escape }}</p>
        {%- endif -%}
      </div>

      {%- for i in (1..3) -%}
        {%- assign heading_key = 'col' | append: i | append: '_heading' -%}
        {%- assign menu_key = 'col' | append: i | append: '_menu' -%}
        {%- assign col_menu = section.settings[menu_key] -%}
        <nav class="cv-foot__col" aria-label="{{ section.settings[heading_key] | escape }}">
          <h3>{{ section.settings[heading_key] | escape }}</h3>
          {%- if col_menu != blank and col_menu.links.size > 0 -%}
            <ul role="list">
              {%- for link in col_menu.links -%}
                <li><a href="{{ link.url }}">{{ link.title | escape }}</a></li>
              {%- endfor -%}
            </ul>
          {%- elsif request.design_mode -%}
            <p class="cv-foot__hint">Choisissez un menu dans les réglages de la section.</p>
          {%- endif -%}
        </nav>
      {%- endfor -%}
    </div>

    <div class="cv-foot__bottom">
      <span>&copy; {{ 'now' | date: '%Y' }} {{ shop.name | escape }}{% if section.settings.bottom_left != blank %} — {{ section.settings.bottom_left | escape }}{% endif %}</span>
      {%- if section.settings.bottom_right != blank -%}
        <span>{{ section.settings.bottom_right | escape }}</span>
      {%- endif -%}
    </div>
  </div>
</footer>

{% stylesheet %}
  .cv-foot {
    position: relative;
    overflow: hidden;
    isolation: isolate;
    color: #f2f7fb;
    background: var(--cv-navy-deep, #021d30);
  }

  .cv-foot__halo {
    inline-size: 520px;
    block-size: 420px;
    inset-block-start: -140px;
    inset-inline-end: -120px;
    opacity: 0.5;
    z-index: -1;
  }

  .cv-foot__inner { padding-block: clamp(3rem, 7vw, 5rem) clamp(2rem, 4vw, 3rem); }

  .cv-foot__news {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem 2rem;
    padding: clamp(1.5rem, 4vw, 2.75rem);
    border-radius: 28px;
  }

  .cv-foot__news-title {
    margin: 0 0 0.5rem;
    font-family: var(--font-heading--family);
    font-size: clamp(1.75rem, 3.4vw, 2.5rem);
    line-height: 1;
    font-weight: 800;
    font-stretch: 115%;
    letter-spacing: -0.015em;
    text-transform: uppercase;
    color: #fff;
  }
  .cv-foot__news-text { margin: 0; color: rgb(242 247 251 / 74%); }

  .cv-foot__form { display: flex; flex-wrap: wrap; gap: 0.625rem; flex: 1 1 360px; max-inline-size: 520px; }

  .cv-foot__input {
    flex: 1 1 220px;
    min-block-size: 52px;
    padding-inline: 1rem;
    font-size: 1rem;
    color: #fff;
    background: rgb(0 0 0 / 22%);
    border: 1.5px solid rgb(255 255 255 / 22%);
    border-radius: 14px;
  }
  .cv-foot__input::placeholder { color: rgb(242 247 251 / 55%); }
  .cv-foot__input:focus { outline: none; border-color: var(--cv-blue-hover, #00a5e2); box-shadow: 0 0 0 4px rgb(0 165 226 / 22%); }

  .cv-foot__submit {
    min-block-size: 52px;
    padding-inline: 1.75rem;
    font: inherit;
    font-weight: 700;
    color: var(--cv-navy-deep, #021d30);
    background: var(--cv-blue-hover, #00a5e2);
    border: 0;
    border-radius: 999px;
    cursor: pointer;
    transition: transform 0.2s var(--cv-ease, ease), background-color 0.2s var(--cv-ease, ease);
  }
  .cv-foot__submit:hover { transform: translateY(-2px); background: #fff; }

  .cv-foot__msg { flex-basis: 100%; margin: 0; font-size: 0.875rem; }
  .cv-foot__msg--ok { color: #5fdc9a; }
  .cv-foot__msg--err { color: var(--cv-coral-hover, #fa887c); }

  .cv-foot__grid {
    display: grid;
    gap: 2rem;
    margin-block-start: clamp(2.5rem, 6vw, 4rem);
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
  .cv-foot__brand { grid-column: span 2; }

  @media (min-width: 990px) {
    .cv-foot__grid { grid-template-columns: 2fr repeat(3, minmax(0, 1fr)); }
    .cv-foot__brand { grid-column: auto; }
  }

  .cv-foot__logo { display: flex; flex-direction: column; margin: 0 0 1rem; line-height: 1; }
  .cv-foot__logo strong {
    font-family: var(--font-heading--family);
    font-size: 1.3125rem;
    font-weight: 900;
    letter-spacing: 0.01em;
    text-transform: uppercase;
    color: #fff;
  }
  .cv-foot__logo span {
    margin-block-start: 0.4rem;
    font-size: 0.65625rem;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--cv-sky, #90c4e6);
  }

  .cv-foot__about { margin: 0; max-inline-size: 21rem; font-size: 0.90625rem; line-height: 1.6; color: rgb(242 247 251 / 74%); }

  .cv-foot__col h3 {
    margin: 0 0 0.75rem;
    font-family: var(--font-body--family);
    font-size: 0.875rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--cv-sky, #90c4e6);
  }
  .cv-foot__col ul { margin: 0; padding: 0; list-style: none; }
  .cv-foot__col a {
    display: block;
    padding-block: 0.3125rem;
    font-size: 0.90625rem;
    color: rgb(242 247 251 / 74%);
    text-decoration: none;
    transition: color 0.2s var(--cv-ease, ease);
  }
  .cv-foot__col a:hover { color: #fff; }
  .cv-foot__hint { margin: 0; font-size: 0.8125rem; color: rgb(242 247 251 / 50%); }

  .cv-foot__bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.875rem;
    margin-block-start: 3.5rem;
    padding-block-start: 1.5rem;
    border-block-start: 1px solid rgb(255 255 255 / 12%);
    font-size: 0.8125rem;
    color: rgb(242 247 251 / 74%);
  }

  @media (prefers-reduced-motion: reduce) {
    .cv-foot__submit, .cv-foot__col a { transition: none; }
    .cv-foot__submit:hover { transform: none; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "CV · Pied de page",
  "tag": "div",
  "class": "cv-section",
  "settings": [
    { "type": "header", "content": "Inscription newsletter" },
    { "type": "text", "id": "nl_heading", "label": "Titre", "default": "Restez dans la roue", "info": "Vide : le bloc disparaît." },
    { "type": "text", "id": "nl_text", "label": "Texte", "default": "Arrivages, sorties et offres atelier, une fois par mois." },
    { "type": "text", "id": "nl_placeholder", "label": "Texte du champ", "default": "votre@email.fr" },
    { "type": "text", "id": "nl_button", "label": "Bouton", "default": "S'inscrire" },
    { "type": "header", "content": "Marque" },
    { "type": "text", "id": "logo_text", "label": "Nom affiché", "info": "Vide : le nom de la boutique." },
    { "type": "text", "id": "logo_sub", "label": "Sous-titre", "default": "Vélo · Agen" },
    {
      "type": "textarea",
      "id": "about",
      "label": "Description",
      "default": "Vente, atelier et conseil vélo à Agen."
    },
    { "type": "header", "content": "Colonne 1" },
    { "type": "text", "id": "col1_heading", "label": "Titre", "default": "Boutique" },
    { "type": "link_list", "id": "col1_menu", "label": "Menu" },
    { "type": "header", "content": "Colonne 2" },
    { "type": "text", "id": "col2_heading", "label": "Titre", "default": "Services" },
    { "type": "link_list", "id": "col2_menu", "label": "Menu" },
    { "type": "header", "content": "Colonne 3" },
    { "type": "text", "id": "col3_heading", "label": "Titre", "default": "Aide" },
    { "type": "link_list", "id": "col3_menu", "label": "Menu" },
    { "type": "header", "content": "Bas de page" },
    { "type": "text", "id": "bottom_left", "label": "Texte à gauche", "info": "Ajouté après « © année nom »." },
    { "type": "text", "id": "bottom_right", "label": "Texte à droite", "default": "CB · Visa · Mastercard · PayPal" }
  ],
  "presets": [{ "name": "CV · Pied de page" }]
}
{% endschema %}
