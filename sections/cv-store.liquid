{%- comment -%}
  Culture Vélo — « Venez nous voir » : carte stylisée du quartier et fiche du
  magasin en verre dépoli (adresse, horaires, boutons). Les horaires par
  défaut sont à compléter avec le magasin.
{%- endcomment -%}

<section class="cv-store cv-wrap" id="cv-store-{{ section.id }}">
  <div class="cv-store__panel">
    <svg class="cv-store__map" viewBox="0 0 1200 520" preserveAspectRatio="xMidYMid slice" aria-hidden="true" focusable="false">
      <rect width="1200" height="520" fill="#E3EBF2"/>
      <g stroke="#FFFFFF" stroke-width="14" fill="none" stroke-linecap="round">
        <path d="M-20 380 C 200 340, 400 420, 640 300 S 1000 180, 1240 220"/>
        <path d="M700 -20 C 690 120, 760 260, 720 540"/>
        <path d="M300 -20 L 380 540"/>
        <path d="M-20 140 C 300 160, 520 100, 1240 90"/>
      </g>
      <g stroke="#CBD8E3" stroke-width="5" fill="none"><path d="M500 0 L560 520 M0 260 L1200 300 M880 0 L940 520 M150 0 L120 520"/></g>
      <path d="M950 380 C 1020 340 1120 360 1220 330 L1220 540 L900 540Z" fill="#CFE3F2"/>
      <g transform="translate(830 250)">
        <circle r="46" fill="#0969A8" opacity=".18"/>
        <circle r="22" fill="#0969A8"/>
        <circle r="8" fill="#fff"/>
      </g>
    </svg>

    <div class="cv-store__card cv-glass">
      {%- if section.settings.eyebrow != blank -%}
        <p class="cv-store__eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="cv-store__title">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}

      <p class="cv-store__address">
        {%- if section.settings.store_name != blank -%}<strong>{{ section.settings.store_name | escape }}</strong><br>{%- endif -%}
        {{ section.settings.address | escape }}
        {%- if section.settings.phone != blank -%}
          <br><a href="tel:{{ section.settings.phone | replace: ' ', '' }}">{{ section.settings.phone | escape }}</a>
        {%- endif -%}
      </p>

      {%- if section.settings.hours != blank -%}
        <dl class="cv-store__hours">
          {%- assign hours_lines = section.settings.hours | newline_to_br | split: '<br />' -%}
          {%- for line in hours_lines -%}
            {%- assign clean = line | strip | strip_newlines -%}
            {%- if clean != blank -%}
              {%- assign parts = clean | split: '|' -%}
              <dt>{{ parts[0] | strip | escape }}</dt>
              <dd>{{ parts[1] | strip | escape }}</dd>
            {%- endif -%}
          {%- endfor -%}
        </dl>
      {%- endif -%}

      <div class="cv-store__actions">
        {%- if section.settings.address != blank -%}
          <a
            class="cv-store__btn cv-store__btn--primary"
            href="https://www.google.com/maps/search/?api=1&query={{ section.settings.address | url_encode }}"
            target="_blank"
            rel="noopener"
          >Itinéraire</a>
        {%- endif -%}
        {%- if section.settings.contact_label != blank -%}
          <a class="cv-store__btn cv-store__btn--ghost" href="{{ section.settings.contact_link | default: '/pages/contact' }}">
            {{- section.settings.contact_label | escape -}}
          </a>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% stylesheet %}
  .cv-store { padding-block: clamp(2.5rem, 6vw, 5rem); }

  .cv-store__panel {
    position: relative;
    min-block-size: 480px;
    overflow: hidden;
    border-radius: 34px;
    background: var(--cv-mist, #ebf0f5);
  }

  .cv-store__map { position: absolute; inset: 0; inline-size: 100%; block-size: 100%; }

  .cv-store__card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    max-inline-size: 440px;
    margin: 12px;
    padding: 1.5rem;
    border-radius: 26px;
    color: var(--cv-navy, #032942);
    box-shadow: 0 24px 60px -30px rgb(3 41 66 / 45%);
  }

  @media (min-width: 750px) {
    .cv-store__card { margin: 28px; padding: 2rem; }
  }

  .cv-store__eyebrow {
    margin: 0;
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--cv-blue, #0969a8);
  }

  .cv-store__title {
    margin: 0;
    font-family: var(--font-heading--family);
    font-size: clamp(1.75rem, 3vw, 2.5rem);
    line-height: 1;
    font-weight: 800;
    font-stretch: 115%;
    letter-spacing: -0.015em;
    text-transform: uppercase;
    color: var(--cv-navy, #032942);
  }

  .cv-store__address { margin: 0; font-size: 0.96875rem; line-height: 1.55; }
  .cv-store__address a { font-weight: 700; color: var(--cv-blue, #0969a8); text-decoration: none; }
  .cv-store__address a:hover { text-decoration: underline; }

  .cv-store__hours {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.25rem 1.125rem;
    margin: 0;
    font-size: 0.90625rem;
  }
  .cv-store__hours dt { color: rgb(3 41 66 / 62%); }
  .cv-store__hours dd { margin: 0; font-weight: 600; font-variant-numeric: tabular-nums; }

  .cv-store__actions { display: flex; flex-wrap: wrap; gap: 0.625rem; }

  .cv-store__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-block-size: 46px;
    padding-inline: 1.5rem;
    border-radius: 999px;
    font-weight: 700;
    text-decoration: none;
    transition: transform 0.2s var(--cv-ease, ease), background-color 0.2s var(--cv-ease, ease);
  }
  .cv-store__btn:hover { transform: translateY(-2px); }
  .cv-store__btn--primary { background: var(--cv-blue, #0969a8); color: #fff; }
  .cv-store__btn--primary:hover { background: var(--cv-navy, #032942); }
  .cv-store__btn--ghost { color: var(--cv-navy, #032942); border: 1.5px solid var(--cv-navy, #032942); }
  .cv-store__btn--ghost:hover { background: var(--cv-navy, #032942); color: #fff; }

  @media (prefers-reduced-motion: reduce) {
    .cv-store__btn { transition: none; }
    .cv-store__btn:hover { transform: none; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "CV · Magasin (carte)",
  "tag": "section",
  "class": "cv-section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Sur-titre", "default": "Le magasin" },
    { "type": "text", "id": "heading", "label": "Titre", "default": "Venez nous voir" },
    { "type": "text", "id": "store_name", "label": "Nom", "default": "Culture Vélo Agen" },
    { "type": "text", "id": "address", "label": "Adresse", "default": "Zac Agen Sud, Av. de l'Atlantique, 47000 Agen" },
    { "type": "text", "id": "phone", "label": "Téléphone", "default": "05 53 48 08 18" },
    {
      "type": "textarea",
      "id": "hours",
      "label": "Horaires",
      "info": "Une ligne par jour, au format : Jour | Horaires",
      "default": "Lundi - Samedi | À compléter\nDimanche | À compléter"
    },
    { "type": "text", "id": "contact_label", "label": "Bouton secondaire", "default": "Nous contacter" },
    { "type": "url", "id": "contact_link", "label": "Lien du bouton secondaire" }
  ],
  "presets": [{ "name": "CV · Magasin (carte)" }]
}
{% endschema %}
