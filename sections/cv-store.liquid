{%- comment -%}
  Culture Vélo — magasin & atelier : panneau sombre avec services (blocs)
  et carte magasin en verre dépoli (adresse, horaires, téléphone, itinéraire).
  Les horaires par défaut sont à compléter avec le magasin.
{%- endcomment -%}

<section class="cv-store" id="cv-store-{{ section.id }}">
  <span class="cv-halo cv-halo--blue cv-store__halo cv-store__halo--a" aria-hidden="true"></span>
  <span class="cv-halo cv-halo--coral cv-store__halo cv-store__halo--b" aria-hidden="true"></span>

  <div class="cv-store__inner cv-wrap">
    <div class="cv-store__copy">
      {%- if section.settings.eyebrow != blank -%}
        <p class="cv-store__eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="cv-store__title">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}
      {%- if section.settings.text != blank -%}
        <p class="cv-store__text">{{ section.settings.text | escape }}</p>
      {%- endif -%}

      <ul class="cv-store__services" role="list">
        {%- for block in section.blocks -%}
          <li class="cv-store__service" {{ block.shopify_attributes }}>
            <span class="cv-store__check" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12.5l4.5 4.5L19 7.5"/></svg>
            </span>
            <span>
              <strong>{{ block.settings.title | escape }}</strong>
              {%- if block.settings.text != blank -%}
                <span class="cv-store__service-text">{{ block.settings.text | escape }}</span>
              {%- endif -%}
            </span>
          </li>
        {%- endfor -%}
      </ul>
    </div>

    <aside class="cv-store__card cv-glass cv-glass--dark" aria-label="Informations du magasin">
      <p class="cv-stock">{{ section.settings.status | escape }}</p>
      <h3 class="cv-store__card-name">{{ section.settings.store_name | escape }}</h3>

      {%- if section.settings.address != blank -%}
        <p class="cv-store__line">{{ section.settings.address | escape }}</p>
      {%- endif -%}

      {%- if section.settings.hours != blank -%}
        <ul class="cv-store__hours" role="list">
          {%- assign hours_lines = section.settings.hours | newline_to_br | split: '<br />' -%}
          {%- for line in hours_lines -%}
            {%- assign clean = line | strip | strip_newlines -%}
            {%- if clean != blank -%}
              {%- assign parts = clean | split: '|' -%}
              <li>
                <span>{{ parts[0] | strip | escape }}</span>
                <span>{{ parts[1] | strip | escape }}</span>
              </li>
            {%- endif -%}
          {%- endfor -%}
        </ul>
      {%- endif -%}

      <div class="cv-store__actions">
        {%- if section.settings.phone != blank -%}
          <a class="cv-store__btn cv-store__btn--primary" href="tel:{{ section.settings.phone | replace: ' ', '' }}">
            {{- section.settings.phone | escape -}}
          </a>
        {%- endif -%}
        {%- if section.settings.address != blank -%}
          <a
            class="cv-store__btn cv-store__btn--ghost"
            href="https://www.google.com/maps/search/?api=1&query={{ section.settings.address | url_encode }}"
            target="_blank"
            rel="noopener"
          >Itinéraire</a>
        {%- endif -%}
      </div>
    </aside>
  </div>
</section>

{% stylesheet %}
  .cv-store {
    position: relative;
    overflow: hidden;
    isolation: isolate;
    color: #f2f7fb;
    background: linear-gradient(160deg, var(--cv-navy, #032942) 0%, var(--cv-navy-deep, #021d30) 100%);
  }

  .cv-store__halo { z-index: -1; }
  .cv-store__halo--a { inline-size: 480px; block-size: 480px; inset-block-start: -180px; inset-inline-start: -120px; }
  .cv-store__halo--b { inline-size: 340px; block-size: 340px; inset-block-end: -160px; inset-inline-end: 8%; }

  .cv-store__inner {
    display: grid;
    gap: 2.5rem;
    align-items: center;
    padding-block: clamp(3rem, 7vw, 5.5rem);
  }

  @media (min-width: 990px) {
    .cv-store__inner { grid-template-columns: 1.1fr 0.9fr; gap: 4rem; }
  }

  .cv-store__eyebrow {
    margin: 0 0 1rem;
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--cv-sky, #90c4e6);
  }

  .cv-store__title {
    margin: 0 0 1.25rem;
    font-family: var(--font-heading--family);
    font-size: clamp(2rem, 4.6vw, 3.25rem);
    line-height: 1;
    font-weight: 800;
    font-stretch: 115%;
    letter-spacing: -0.015em;
    text-transform: uppercase;
    text-wrap: balance;
    color: #fff;
  }

  .cv-store__text {
    margin: 0 0 1.75rem;
    max-inline-size: 34rem;
    line-height: 1.6;
    color: rgb(242 247 251 / 80%);
  }

  .cv-store__services { display: grid; gap: 1rem; margin: 0; padding: 0; list-style: none; }
  .cv-store__service { display: flex; align-items: flex-start; gap: 0.875rem; }
  .cv-store__service strong { display: block; color: #fff; }
  .cv-store__service-text { display: block; font-size: 0.875rem; line-height: 1.45; color: rgb(242 247 251 / 72%); }

  .cv-store__check {
    flex: none;
    display: grid;
    place-items: center;
    inline-size: 32px;
    block-size: 32px;
    border-radius: 10px;
    color: var(--cv-blue-hover, #00a5e2);
    background: rgb(255 255 255 / 8%);
    border: 1px solid rgb(255 255 255 / 14%);
  }

  .cv-store__card { display: grid; gap: 0.75rem; padding: 1.75rem; border-radius: calc(var(--cv-radius, 18px) * 1.4); }
  .cv-store__card .cv-stock { color: #5fdc9a; }
  .cv-store__card-name {
    margin: 0;
    font-family: var(--font-heading--family);
    font-size: 1.5rem;
    font-weight: 800;
    text-transform: uppercase;
    color: #fff;
  }
  .cv-store__line { margin: 0; color: rgb(242 247 251 / 80%); }

  .cv-store__hours {
    display: grid;
    gap: 0.375rem;
    margin: 0.25rem 0;
    padding: 0.875rem 0;
    list-style: none;
    border-block: 1px solid rgb(255 255 255 / 14%);
    font-size: 0.9375rem;
  }
  .cv-store__hours li { display: flex; justify-content: space-between; gap: 1rem; }
  .cv-store__hours li span:last-child { font-variant-numeric: tabular-nums; color: #fff; }

  .cv-store__actions { display: flex; flex-wrap: wrap; gap: 0.625rem; margin-block-start: 0.5rem; }

  .cv-store__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-block-size: 46px;
    padding-inline: 1.5rem;
    border-radius: 999px;
    font-weight: 700;
    text-decoration: none;
    transition: transform 0.2s var(--cv-ease, ease), background-color 0.2s var(--cv-ease, ease);
  }
  .cv-store__btn:hover { transform: translateY(-2px); }
  .cv-store__btn--primary { background: var(--cv-blue-hover, #00a5e2); color: #fff; }
  .cv-store__btn--primary:hover { background: var(--cv-blue-mid, #0a79c1); }
  .cv-store__btn--ghost { color: #fff; border: 1px solid rgb(255 255 255 / 40%); background: rgb(255 255 255 / 6%); }
  .cv-store__btn--ghost:hover { background: rgb(255 255 255 / 14%); }

  @media (prefers-reduced-motion: reduce) {
    .cv-store__btn { transition: none; }
    .cv-store__btn:hover { transform: none; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "CV · Magasin & atelier",
  "tag": "section",
  "class": "cv-section",
  "settings": [
    { "type": "header", "content": "Texte" },
    { "type": "text", "id": "eyebrow", "label": "Sur-titre", "default": "Le magasin & l'atelier" },
    { "type": "text", "id": "heading", "label": "Titre", "default": "Un vélo bien monté, bien réglé." },
    {
      "type": "textarea",
      "id": "text",
      "label": "Texte",
      "default": "Notre équipe vous conseille, assemble et entretient votre vélo, toutes marques."
    },
    { "type": "header", "content": "Carte magasin" },
    { "type": "text", "id": "status", "label": "Statut", "default": "Ouvert en magasin" },
    { "type": "text", "id": "store_name", "label": "Nom", "default": "Culture Vélo Agen" },
    { "type": "text", "id": "address", "label": "Adresse", "default": "Zac Agen Sud, Av. de l'Atlantique, 47000 Agen" },
    { "type": "text", "id": "phone", "label": "Téléphone", "default": "05 53 48 08 18" },
    {
      "type": "textarea",
      "id": "hours",
      "label": "Horaires",
      "info": "Une ligne par jour, au format : Jour | Horaires",
      "default": "Lundi - Samedi | À compléter\nDimanche | À compléter"
    }
  ],
  "blocks": [
    {
      "type": "service",
      "name": "Service",
      "settings": [
        { "type": "text", "id": "title", "label": "Titre", "default": "Service" },
        { "type": "text", "id": "text", "label": "Texte" }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "CV · Magasin & atelier",
      "blocks": [
        { "type": "service", "settings": { "title": "Montage et réglages", "text": "Chaque vélo est préparé par l'atelier avant de partir." } },
        { "type": "service", "settings": { "title": "Entretien et réparation", "text": "Toutes marques, vélos électriques compris." } },
        { "type": "service", "settings": { "title": "Retrait en magasin", "text": "Commandez en ligne, récupérez à Agen." } }
      ]
    }
  ]
}
{% endschema %}
