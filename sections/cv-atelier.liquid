{%- comment -%}
  Culture Vélo — atelier : panneau sombre avec services (blocs « Service »),
  visuel avec pastille en verre dépoli, et rangée de marques (blocs « Marque »).
  Une marque accepte un logo ; sans logo, son nom s'affiche en texte.
{%- endcomment -%}

<section class="cv-atelier" id="cv-atelier-{{ section.id }}">
  <span class="cv-halo cv-halo--blue cv-atelier__halo cv-atelier__halo--a" aria-hidden="true"></span>
  <span class="cv-halo cv-halo--coral cv-atelier__halo cv-atelier__halo--b" aria-hidden="true"></span>

  <div class="cv-atelier__inner cv-wrap">
    <div class="cv-atelier__visual">
      {%- if section.settings.image != blank -%}
        {{
          section.settings.image
          | image_url: width: 1200
          | image_tag:
            loading: 'lazy',
            widths: '500, 800, 1200',
            sizes: '(min-width: 990px) 45vw, 100vw',
            class: 'cv-atelier__img',
            alt: section.settings.image.alt
        }}
      {%- else -%}
        <span class="cv-atelier__placeholder" aria-hidden="true"></span>
      {%- endif -%}
      {%- if section.settings.chip != blank -%}
        <span class="cv-atelier__chip cv-glass cv-glass--dark">
          <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14.7 6.3a1 1 0 000 1.4l1.6 1.6a1 1 0 001.4 0l3.77-3.77a6 6 0 01-7.94 7.94l-6.91 6.91a2.12 2.12 0 01-3-3l6.91-6.91a6 6 0 017.94-7.94l-3.76 3.76z"/></svg>
          {{ section.settings.chip | escape }}
        </span>
      {%- endif -%}
    </div>

    <div class="cv-atelier__copy">
      {%- if section.settings.eyebrow != blank -%}
        <p class="cv-atelier__eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="cv-atelier__title">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}
      {%- if section.settings.text != blank -%}
        <p class="cv-atelier__text">{{ section.settings.text | escape }}</p>
      {%- endif -%}

      <ul class="cv-atelier__services" role="list">
        {%- for block in section.blocks -%}
          {%- if block.type == 'service' -%}
            <li class="cv-atelier__service" {{ block.shopify_attributes }}>
              <span class="cv-atelier__check" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12.5l4.5 4.5L19 7.5"/></svg>
              </span>
              <span>
                <strong>{{ block.settings.title | escape }}</strong>
                {%- if block.settings.text != blank -%}
                  <span class="cv-atelier__service-text">{{ block.settings.text | escape }}</span>
                {%- endif -%}
              </span>
            </li>
          {%- endif -%}
        {%- endfor -%}
      </ul>

      {%- if section.settings.button_label != blank -%}
        <a class="cv-atelier__btn" href="{{ section.settings.button_link | default: '/pages/contact' }}">
          {{- section.settings.button_label | escape -}}
        </a>
      {%- endif -%}
    </div>
  </div>

  {%- assign brands = section.blocks | where: 'type', 'brand' -%}
  {%- if brands.size > 0 -%}
    <div class="cv-atelier__brands cv-wrap">
      {%- if section.settings.brands_title != blank -%}
        <p class="cv-atelier__brands-title">{{ section.settings.brands_title | escape }}</p>
      {%- endif -%}
      <ul class="cv-atelier__brand-list" role="list">
        {%- for block in brands -%}
          <li class="cv-atelier__brand cv-glass cv-glass--dark" {{ block.shopify_attributes }}>
            {%- if block.settings.logo != blank -%}
              {{
                block.settings.logo
                | image_url: width: 300
                | image_tag: loading: 'lazy', class: 'cv-atelier__logo', alt: block.settings.name
              }}
            {%- else -%}
              <span>{{ block.settings.name | escape }}</span>
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ul>
    </div>
  {%- endif -%}
</section>

{% stylesheet %}
  .cv-atelier {
    position: relative;
    overflow: hidden;
    isolation: isolate;
    color: #f2f7fb;
    background: linear-gradient(160deg, var(--cv-navy, #032942) 0%, var(--cv-navy-deep, #021d30) 100%);
  }

  .cv-atelier__halo { z-index: -1; }
  .cv-atelier__halo--a { inline-size: 480px; block-size: 480px; inset-block-start: -180px; inset-inline-end: -120px; }
  .cv-atelier__halo--b { inline-size: 340px; block-size: 340px; inset-block-end: -160px; inset-inline-start: 10%; }

  .cv-atelier__inner {
    display: grid;
    gap: 2.5rem;
    align-items: center;
    padding-block: clamp(3rem, 7vw, 5.5rem);
  }

  @media (min-width: 990px) {
    .cv-atelier__inner { grid-template-columns: 0.95fr 1.05fr; gap: 4.5rem; }
  }

  .cv-atelier__visual {
    position: relative;
    overflow: hidden;
    aspect-ratio: 1 / 0.92;
    border-radius: 32px;
    background: var(--cv-navy-700, #05426b);
    box-shadow: 0 30px 80px rgb(0 0 0 / 35%);
  }

  .cv-atelier__img { position: absolute; inset: 0; inline-size: 100%; block-size: 100%; object-fit: cover; }

  .cv-atelier__placeholder {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(60% 60% at 30% 30%, rgb(0 165 226 / 35%), transparent 70%),
      linear-gradient(150deg, var(--cv-navy-700, #05426b), var(--cv-navy, #032942));
  }

  .cv-atelier__chip {
    position: absolute;
    inset-inline-start: 1.125rem;
    inset-block-end: 1.125rem;
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    padding: 0.75rem 1rem;
    border-radius: 16px;
    font-weight: 600;
    font-size: 0.875rem;
  }

  .cv-atelier__eyebrow {
    margin: 0 0 1rem;
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--cv-sky, #90c4e6);
  }

  .cv-atelier__title {
    margin: 0 0 1.25rem;
    font-family: var(--font-heading--family);
    font-size: clamp(2rem, 4.4vw, 3.5rem);
    line-height: 1;
    font-weight: 800;
    font-stretch: 115%;
    letter-spacing: -0.015em;
    text-transform: uppercase;
    text-wrap: balance;
    color: #fff;
  }

  .cv-atelier__text { margin: 0 0 1.75rem; max-inline-size: 34rem; line-height: 1.6; color: rgb(242 247 251 / 80%); }

  .cv-atelier__services { display: grid; gap: 1rem; margin: 0 0 2rem; padding: 0; list-style: none; }
  .cv-atelier__service { display: flex; align-items: flex-start; gap: 0.875rem; }
  .cv-atelier__service strong { display: block; color: #fff; }
  .cv-atelier__service-text { display: block; font-size: 0.875rem; line-height: 1.45; color: rgb(242 247 251 / 72%); }

  .cv-atelier__check {
    flex: none;
    display: grid;
    place-items: center;
    inline-size: 32px;
    block-size: 32px;
    border-radius: 10px;
    color: var(--cv-blue-hover, #00a5e2);
    background: rgb(255 255 255 / 8%);
    border: 1px solid rgb(255 255 255 / 14%);
  }

  .cv-atelier__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-block-size: 48px;
    padding-inline: 1.75rem;
    border-radius: 999px;
    font-weight: 700;
    text-decoration: none;
    color: #fff;
    background: var(--cv-blue-hover, #00a5e2);
    transition: transform 0.2s var(--cv-ease, ease), background-color 0.2s var(--cv-ease, ease);
  }
  .cv-atelier__btn:hover { transform: translateY(-2px); background: var(--cv-blue-mid, #0a79c1); }

  .cv-atelier__brands { padding-block: 0 clamp(3rem, 6vw, 5rem); }

  .cv-atelier__brands-title {
    margin: 0 0 1.375rem;
    text-align: center;
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgb(242 247 251 / 72%);
  }

  .cv-atelier__brand-list {
    display: grid;
    gap: 0.75rem;
    margin: 0;
    padding: 0;
    list-style: none;
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
  @media (min-width: 750px) { .cv-atelier__brand-list { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  @media (min-width: 990px) { .cv-atelier__brand-list { grid-template-columns: repeat(6, minmax(0, 1fr)); } }

  .cv-atelier__brand {
    display: flex;
    align-items: center;
    justify-content: center;
    block-size: 84px;
    border-radius: 16px;
    font-size: 0.8125rem;
    font-weight: 600;
    color: rgb(242 247 251 / 80%);
  }
  .cv-atelier__logo { max-block-size: 44px; max-inline-size: 70%; inline-size: auto; object-fit: contain; filter: brightness(0) invert(1); opacity: 0.85; }

  @media (prefers-reduced-motion: reduce) {
    .cv-atelier__btn { transition: none; }
    .cv-atelier__btn:hover { transform: none; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "CV · Atelier",
  "tag": "section",
  "class": "cv-section",
  "settings": [
    { "type": "header", "content": "Texte" },
    { "type": "text", "id": "eyebrow", "label": "Sur-titre", "default": "L'atelier" },
    { "type": "text", "id": "heading", "label": "Titre", "default": "Entretien & réparation toutes marques" },
    {
      "type": "textarea",
      "id": "text",
      "label": "Texte",
      "default": "Notre équipe vous conseille, assemble et entretient votre vélo, vélos électriques compris."
    },
    { "type": "text", "id": "button_label", "label": "Bouton", "default": "Prendre rendez-vous" },
    { "type": "url", "id": "button_link", "label": "Lien du bouton" },
    { "type": "header", "content": "Visuel" },
    { "type": "image_picker", "id": "image", "label": "Photo de l'atelier" },
    { "type": "text", "id": "chip", "label": "Pastille sur la photo", "default": "Toutes marques, VAE compris" },
    { "type": "header", "content": "Marques" },
    { "type": "text", "id": "brands_title", "label": "Titre de la rangée", "default": "Les marques du magasin" }
  ],
  "blocks": [
    {
      "type": "service",
      "name": "Service",
      "settings": [
        { "type": "text", "id": "title", "label": "Titre", "default": "Service" },
        { "type": "text", "id": "text", "label": "Texte" }
      ]
    },
    {
      "type": "brand",
      "name": "Marque",
      "settings": [
        { "type": "text", "id": "name", "label": "Nom", "default": "Marque" },
        { "type": "image_picker", "id": "logo", "label": "Logo (facultatif)" }
      ]
    }
  ],
  "max_blocks": 14,
  "presets": [
    {
      "name": "CV · Atelier",
      "blocks": [
        { "type": "service", "settings": { "title": "Montage et réglages", "text": "Chaque vélo est préparé par l'atelier avant de partir." } },
        { "type": "service", "settings": { "title": "Entretien et réparation", "text": "Toutes marques, vélos électriques compris." } },
        { "type": "service", "settings": { "title": "Retrait en magasin", "text": "Commandez en ligne, récupérez à Agen." } },
        { "type": "brand", "settings": { "name": "Marque 1" } },
        { "type": "brand", "settings": { "name": "Marque 2" } },
        { "type": "brand", "settings": { "name": "Marque 3" } },
        { "type": "brand", "settings": { "name": "Marque 4" } },
        { "type": "brand", "settings": { "name": "Marque 5" } },
        { "type": "brand", "settings": { "name": "Marque 6" } }
      ]
    }
  ]
}
{% endschema %}
